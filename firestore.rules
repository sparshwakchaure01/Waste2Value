rules_version = '2';

// Waste2Value — Firestore security rules (free Spark-plan prototype)
//
// KNOWN LIMITATION (documented honestly, see README.md "Security model"):
// True field-level confidentiality — hiding a seller's phone/company fields
// from a buyer's Firestore reads until both sides accept — normally needs
// server-side logic (e.g. a Cloud Function returning a redacted view). Cloud
// Functions require Firebase's paid Blaze plan. On the free Spark plan there
// is no server compute, so these rules can only gate DOCUMENT-level access
// (who can read/write which documents), not which *fields* inside an allowed
// document a client may see.
//
// The "Blind Reveal" confidentiality flow is therefore enforced at the
// APPLICATION layer: the UI only displays contact fields when
// src/services/requests.js's revealLevel(status) allows it. A user who opened
// devtools and queried Firestore directly could read another user's profile
// earlier than the UI shows it. This is a known, accepted trade-off for a
// free-tier prototype; Blaze + Cloud Functions would close the gap.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Keep in sync with ADMIN_EMAILS in src/data/categories.js
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'wakchauresparsh77@gmail.com',
        'yashhande9529@gmail.com',
        'mahalechetan648@gmail.com',
        'ndfirodiya@gmail.com'
      ];
    }

    function isLogistics() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'logistics';
    }

    // Users: any signed-in user can read profiles (needed to show the other
    // side's details once revealLevel allows it, and for the admin user list).
    // A user can only create/update their own doc, and can't change their role.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role in ['industry', 'logistics'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Listings: anyone signed in can browse. Only the owner (the seller) can
    // create, update (incl. flipping status to "Matched" on accept) or delete.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Requests: readable by the buyer or seller involved; logistics operators
    // can read accepted/completed deals; admins can read all (analytics).
    // A buyer creates a 'pending' request against a listing's real owner.
    // Only the seller can change status — the buyer cannot self-accept — plus a
    // logistics operator may mark an accepted deal in their districts as picked up.
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        (resource.data.status in ['accepted', 'completed'] && isLogistics()) ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.sellerId ==
           get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          resource.data.sellerId == request.auth.uid ||
          // logistics operator confirming pickup of an accepted deal in their own districts
          (isLogistics()
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'completed'
            && resource.data.district in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.districts)
        );
      allow delete: if false;
    }
  }
}
