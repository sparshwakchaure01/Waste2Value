rules_version = '2';

// Waste2Value — Firestore security rules (free Spark-plan prototype)
//
// KNOWN LIMITATION: field-level confidentiality needs server-side logic
// (Cloud Functions need the paid Blaze plan). These rules only gate
// DOCUMENT-level access. The Blind Reveal flow is therefore enforced at the
// application layer via revealLevel(status) in src/services/requests.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Keep in sync with ADMIN_EMAILS in src/data/categories.js
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'wakchauresparsh77@gmail.com',
        'yashhande9529@gmail.com',
        'mahalechetan648@gmail.com',
        'ndfirodiya@gmail.com'
      ];
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // A suspended user (users/{uid}.disabled == true, set by an admin) can't create anything.
    function isActive() {
      return !userData(request.auth.uid).get('disabled', false);
    }

    function isLogistics() {
      return isSignedIn() && userData(request.auth.uid).role == 'logistics';
    }

    // Users: any signed-in user can read profiles (needed to show the other
    // side's details once revealLevel allows it, and for the admin user list).
    // A user can only create/update their own doc, and can't change their role.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.role in ['industry', 'logistics']
        && !('verified' in request.resource.data) && !('disabled' in request.resource.data);
      allow update: if
        (isOwner(userId) && request.resource.data.role == resource.data.role
          && request.resource.data.get('verified', false) == resource.data.get('verified', false)
          && request.resource.data.get('disabled', false) == resource.data.get('disabled', false))
        ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'disabled']));
      allow delete: if false;
    }

    // Listings: anyone signed in can browse. Only the owner (the seller) can
    // create, update (incl. flipping status to "Matched" on accept) or delete.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && isActive();
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && isActive()) ||
        // admin moderation: change status only
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Requests (deals): readable only by the buyer, the seller, or admins.
    // A buyer creates a 'pending' request against a listing's real owner.
    // The seller changes status (decline / discuss / accept). A logistics partner can only touch
    // a deal after the buyer or seller sent them a transport request:
    //   - accepting it assigns them (sets logisticsId, only while nobody is assigned)
    //   - delivering it completes the deal (only after they marked it in transit)
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isActive()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.sellerId ==
           get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId;
      allow update: if isSignedIn() && (
        // seller decides on the request, or sends a counter-offer
        (resource.data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'counter']))
        ||
        // buyer accepts / declines an open counter-offer (terms themselves can't change)
        (resource.data.buyerId == request.auth.uid
          && 'counter' in resource.data
          && resource.data.counter.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counter', 'updatedAt'])
          && request.resource.data.counter.status in ['accepted', 'declined']
          && request.resource.data.counter.price == resource.data.counter.price
          && request.resource.data.counter.qty == resource.data.counter.qty)
        ||
        // partner who was asked takes the job (only while the deal has no partner yet)
        (isLogistics()
          && resource.data.status == 'accepted'
          && !('logisticsId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logisticsId', 'updatedAt'])
          && request.resource.data.logisticsId == request.auth.uid
          && get(/databases/$(database)/documents/transports/$(requestId + '_' + request.auth.uid)).data.status == 'pending')
        ||
        // assigned partner completes the delivery
        (isLogistics()
          && resource.data.status == 'accepted'
          && resource.data.get('logisticsId', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'completed'
          && get(/databases/$(database)/documents/transports/$(requestId + '_' + request.auth.uid)).data.status == 'in_transit')
      );
      allow delete: if false;
    }

    // Transport requests: the buyer or seller of an ACCEPTED deal asks one logistics partner who
    // covers the route (any district, or the pickup / drop district). Doc id = requestId_logisticsId.
    // Only the addressed partner can read-and-act on it besides the two deal parties and admins.
    match /transports/{transportId} {
      allow read: if isSignedIn() && (
        resource.data.logisticsId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && isActive()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && (request.resource.data.sellerId == request.auth.uid || request.resource.data.buyerId == request.auth.uid)
        && transportId == request.resource.data.requestId + '_' + request.resource.data.logisticsId
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.buyerId == request.resource.data.buyerId
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.district == request.resource.data.fromDistrict
        && !('logisticsId' in get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data)
        && userData(request.resource.data.buyerId).district == request.resource.data.toDistrict
        && userData(request.resource.data.logisticsId).role == 'logistics'
        && (
          userData(request.resource.data.logisticsId).get('servesAll', false) == true ||
          request.resource.data.fromDistrict in userData(request.resource.data.logisticsId).get('districts', []) ||
          request.resource.data.toDistrict in userData(request.resource.data.logisticsId).get('districts', [])
        );
      allow update: if isSignedIn() && resource.data.logisticsId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (resource.data.status == 'pending' && request.resource.data.status == 'declined') ||
          (resource.data.status == 'pending' && request.resource.data.status == 'accepted'
            && !('logisticsId' in get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data)) ||
          (resource.data.status == 'accepted' && request.resource.data.status == 'in_transit') ||
          (resource.data.status == 'in_transit' && request.resource.data.status == 'completed')
        );
      allow delete: if false;
    }

    // Reviews: written once by a party of a DELIVERED deal about the other party or the transport
    // partner. Doc id = requestId_reviewerId_revieweeId. Anyone signed in can read (reputation).
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActive()
        && request.resource.data.reviewerId == request.auth.uid
        && reviewId == request.resource.data.requestId + '_' + request.auth.uid + '_' + request.resource.data.revieweeId
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status == 'completed'
        && (get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.sellerId == request.auth.uid
            || get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.buyerId == request.auth.uid)
        && request.resource.data.revieweeId != request.auth.uid
        && request.resource.data.revieweeId in [
          get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.sellerId,
          get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.buyerId,
          get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.get('logisticsId', '')
        ];
      allow update, delete: if false;
    }

    // Platform announcement banner (config/announcement) — everyone reads, admins write.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin action log — admins only.
    match /adminLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
